{
  "schemaVersion": 1,
  "reviewDate": "2026-11-15",
  "scope": "Bounded editorial audit of three known source overruns and one adjacent Trebizond tail; not an audit of all Cliopatria polygons. Original GeoJSON remains unchanged.",
  "matching": "Match exact properties.original strings, including parentheses and capitalization; recordIds only where specified.",
  "yearPolicy": "Hard-invalid tails start in the calendar year AFTER the authoritative endpoint, so annual selection does not invent a within-year date. transitionYears additionally supports after-event views in the endpoint year. The Carolingian rule chooses post-Verdun constituent-kingdom display, not an extinction date.",
  "selectionOrder": [
    "Select source interval candidates",
    "Apply exact-name editorial hide rules",
    "Apply optional after-event hides for transition year",
    "Recompute the set of remaining original names",
    "Suppress memberOf children only if a referenced parent is still present",
    "Do not auto-fill removed geometry or propagate an excluded parent to its children"
  ],
  "sources": {
    "almohad-getty": {
      "title": "Getty Research Institute, Art & Architecture Thesaurus: Almohad",
      "url": "https://www.getty.edu/vow/AATFullDisplay?find=archaeological+Park&logic=AND&note=&subjectid=300021528",
      "supports": "穆瓦希德统治的终止年1269，马林王朝攻取马拉喀什。"
    },
    "verdun-cambridge": {
      "title": "Costambeys, Innes & MacLean, The Carolingian World, chapter 8",
      "url": "https://www.cambridge.org/core/books/abs/carolingian-world/sustaining-the-carolingian-empire-politics-and-government-840888/08F8DE8C2992F780AC03E849C82FA4E3",
      "doi": "10.1017/CBO9780511973987.010",
      "supports": "843年凡尔登分治为西、中、东三份；不支持将843直接等同于加洛林皇帝名号或王朝的终结。"
    },
    "reunion-loc": {
      "title": "Library of Congress authority record: Charles III, Holy Roman Emperor",
      "url": "https://lccn.loc.gov/n2003037040",
      "supports": "查理三世至884年重新统治多个王国，887年被废，888年去世；因此843后的分治不是一条不可逆的简单终结线。"
    },
    "byzantium-met": {
      "title": "The Metropolitan Museum of Art: Byzantium, Faith and Power",
      "url": "https://www.metmuseum.org/exhibitions/listings/2004/byzantium-faith-and-power",
      "supports": "1261年君士坦丁堡恢复帝国统治；1453年帝国陷落。"
    },
    "trebizond-met": {
      "title": "The Metropolitan Museum of Art: Cassone depicting the Conquest of Trebizond",
      "url": "https://www.metmuseum.org/art/collection/search/192693",
      "supports": "1453年君士坦丁堡被奥斯曼攻陷；特拉比松是独立后继政权，1461年陷落。"
    }
  },
  "rules": [
    {
      "id": "almohad-tail",
      "exactOriginal": [
        "Almohad Caliphate"
      ],
      "action": "hide",
      "fromYear": 1270,
      "toYear": 2024,
      "historicalEndpointYear": 1269,
      "sourceIds": [
        "almohad-getty"
      ],
      "reasonZh": "原始几何记录延伸到1343年，超过1269年王朝终止，删除确定错误的后续显示；不将其领土自动赋给马林王朝。"
    },
    {
      "id": "byzantine-tail",
      "exactOriginal": [
        "Byzantine Empire"
      ],
      "action": "hide",
      "fromYear": 1454,
      "toYear": 2024,
      "historicalEndpointYear": 1453,
      "sourceIds": [
        "byzantium-met",
        "trebizond-met"
      ],
      "reasonZh": "君士坦丁堡帝国1453年终结，原始记录延伸到1474年；仅精确匹配该名称，不误删特拉比松等单独政权。"
    },
    {
      "id": "carolingian-aggregate-after-partition",
      "exactOriginal": [
        "(Carolingian Empire)",
        "(Allegiance of East Franks to Carolingian Empire)"
      ],
      "action": "hide",
      "fromYear": 843,
      "toYear": 2024,
      "sourceIds": [
        "verdun-cambridge",
        "reunion-loc"
      ],
      "reasonZh": "自凡尔登分治起，普通政治地图选择呈现王国分区，隐藏会压过分区的帝国及效忠关系聚合层。这是显示层级选择，不宣称843年加洛林皇统或王朝终结。884—887年共主重聚另见说明。"
    },
    {
      "id": "unpartitioned-franks-gap-843-849",
      "exactOriginal": [
        "(Kingdom of the Franks)",
        "Kingdom of the Franks"
      ],
      "recordIds": [
        3115,
        3121
      ],
      "action": "hide",
      "fromYear": 843,
      "toYear": 849,
      "sourceIds": [
        "verdun-cambridge"
      ],
      "reasonZh": "源数据840—849区间未表达843年分治。仅去除Carolingian聚合后会冒出仍然统一的Kingdom of the Franks层，所以同时抑制这两条旧图；缺失843—849年分区暂留空，不拿850年几何无依据回填。"
    },
    {
      "id": "trebizond-adjacent-tail",
      "exactOriginal": [
        "Empire of Trebizond"
      ],
      "action": "hide",
      "fromYear": 1462,
      "toYear": 2024,
      "historicalEndpointYear": 1461,
      "sourceIds": [
        "trebizond-met"
      ],
      "reasonZh": "相关核查发现其末条记录延至1462；保留1454—1461年的独立特拉比松记录，仅去除1461年陷落后的尾段。"
    }
  ],
